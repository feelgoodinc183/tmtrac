# GEMINI_API_KEY: Required for Gemini AI API calls (Race Committee Assistant, Image analysis).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Primary URL where TMTRAC is hosted.
# In Exabytes cPanel production: https://tmtrac.my
APP_URL="https://tmtrac.my"

# Optional Production Configurations for Exabytes cPanel:
PORT=3000
NODE_ENV="production"
ALLOWED_ORIGINS="https://tmtrac.my,https://www.tmtrac.my,https://tmrac.my"
SQLITE_DB_PATH="/home/tmtecq00/public_html/tmtrac.my/data/tmtrac.db"

# SUPER_ADMIN_PASSWORD: used only when the Super Admin account is first created. Never reset afterwards.
SUPER_ADMIN_PASSWORD=""

# Stripe Payment & Billing Configuration (Server-side only)
# Get your restricted/secret keys from: https://dashboard.stripe.com/apikeys
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_SECRET_KEY="rk_live_... or sk_live_... or sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_live_... or pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
